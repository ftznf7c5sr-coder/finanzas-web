{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "src/*": ["./src/*"]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "*.config.js"]
}
